<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Student Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #F4F7FE;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }
        .login-card {
            background: #fff;
            padding: 50px 40px;
            border-radius: 24px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            max-width: 420px;
            width: 100%;
        }
        .logo-box {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #FF9C00, #FFC048);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 24px;
            font-weight: 700;
            margin: 0 auto 20px auto;
        }
        h3 { color: #2B3674; font-weight: 700; text-align: center; }
        .subtext { color: #A3AED0; text-align: center; margin-bottom: 30px; }
        .form-control {
            background-color: #F8FAFC;
            border: 1px solid #E2E8F0;
            border-radius: 12px;
            padding: 12px 16px;
        }
        .form-control:focus {
            background-color: #fff;
            border-color: #6366F1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
        }
        .btn-primary {
            background-color: #6366F1;
            border: none;
            border-radius: 12px;
            padding: 12px;
            font-weight: 600;
            width: 100%;
            transition: all 0.3s ease;
        }
        .btn-primary:hover {
            background-color: #4F46E5;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="logo-box">S</div>
        <h3>Welcome Back</h3>
        <p class="subtext">Student Management System</p>
        
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger p-2 text-center" style="border-radius:10px;"><%= error %></div>
        <% } %>

        <form action="/login" method="POST">
            <div class="mb-3">
                <input type="email" name="email" class="form-control" placeholder="Email Address" required>
            </div>
            <div class="mb-4">
                <input type="password" name="password" class="form-control" placeholder="Password" required>
            </div>
            <button type="submit" class="btn btn-primary">Sign In</button>
        </form>
    </div>
</body>
</html>
