<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SMS - Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { 
            font-family: 'Inter', sans-serif; 
            background: #F4F7FE; 
            height: 100vh; 
            display: flex; align-items: center; justify-content: center; 
        }
        .login-card { 
            background: white; 
            padding: 50px 40px; 
            border-radius: 24px; 
            box-shadow: 0 10px 40px rgba(0,0,0,0.05); 
            width: 100%; 
            max-width: 420px; 
        }
        .logo-box {
            background: linear-gradient(135deg, #FF9C00, #FFC048);
            width: 50px; height: 50px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            color: white; font-weight: bold; font-size: 24px; margin: 0 auto 15px;
        }
        .form-control {
            border-radius: 12px; padding: 12px 15px; border: 1px solid #E2E8F0;
            background: #F8FAFC;
        }
        .form-control:focus { box-shadow: none; border-color: #6366F1; background: #fff;}
        .btn-primary { 
            background: #6366F1; border: none; border-radius: 12px; 
            font-weight: 600; padding: 12px; 
        }
        .btn-primary:hover { background: #4F46E5; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="logo-box">S</div>
        <h3 class="text-center mb-1 fw-bold">Welcome Back</h3>
        <p class="text-center text-muted mb-4 fs-6">Student Management System</p>
        
        <% if(error) { %><div class="alert alert-danger" style="border-radius: 10px;"><%= error %></div><% } %>
        
        <form method="POST" action="/login">
            <div class="mb-3">
                <label class="form-label text-muted fw-semibold small">Email Address</label>
                <input type="text" name="email" class="form-control" required placeholder="Enter email">
            </div>
            <div class="mb-4">
                <label class="form-label text-muted fw-semibold small">Password</label>
                <input type="password" name="password" class="form-control" required placeholder="Enter password">
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2">Sign In</button>
        </form>
    </div>
</body>
</html>
